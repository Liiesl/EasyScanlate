QDialog {
    background-color: var(--tredecenary);
    color: var(--text);
}
QGroupBox {
    font-weight: bold;
    border: 2px solid var(--border_input);
    border-radius: var(--border_radius_small);
    margin-top: var(--spacing_large);
    padding-top: var(--spacing_large);
    background-color: var(--quaternary);
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: var(--spacing_large);
    padding: 0 var(--padding_medium);
}
QLabel {
    color: var(--text);
}
QPushButton {
    background-color: var(--secondary);
    color: var(--text);
    border: 1px solid var(--border_input);
    border-radius: var(--border_radius_small);
    padding: var(--padding_6) var(--spacing_xlarge);
    min-width: 80px;
}
QPushButton:hover {
    background-color: var(--duodenary);
}
QPushButton:pressed {
    background-color: var(--primary);
}
QComboBox {
    background-color: var(--primary);
    color: var(--text);
    border: 1px solid var(--border_input);
    border-radius: var(--border_radius_small);
    padding: var(--padding_small) var(--padding_large);
    min-width: 150px;
}
QComboBox:hover {
    background-color: var(--secondary);
}
QComboBox::drop-down {
    border: none;
}
QComboBox QAbstractItemView {
    background-color: var(--primary);
    color: var(--text);
    selection-background-color: var(--duodenary);
}
QRadioButton {
    color: var(--text);
    spacing: var(--spacing_small);
}
QRadioButton::indicator {
    width: var(--indicator_size_checkbox);
    height: var(--indicator_size_checkbox);
    border-radius: 8px;
    border: 2px solid var(--border_input);
    background-color: var(--tredecenary);
}
QRadioButton::indicator:checked {
    background-color: var(--accent_checked);
    border-color: var(--accent_checked);
}
QCheckBox {
    color: var(--text);
    spacing: var(--spacing_small);
}
QCheckBox::indicator {
    width: var(--indicator_size_checkbox);
    height: var(--indicator_size_checkbox);
    border: 2px solid var(--border_input);
    border-radius: 3px;
    background-color: var(--tredecenary);
}
QCheckBox::indicator:checked {
    background-color: var(--accent_checked);
    border-color: var(--accent_checked);
}
QLineEdit {
    background-color: var(--primary);
    color: var(--text);
    border: 1px solid var(--border_input);
    border-radius: var(--border_radius_small);
    padding: var(--padding_small) var(--padding_large);
}
QLineEdit:focus {
    border-color: var(--accent_checked);
}
QSpinBox {
    background-color: var(--primary);
    color: var(--text);
    border: 1px solid var(--border_input);
    border-radius: var(--border_radius_small);
    padding: var(--padding_small) var(--padding_large);
}