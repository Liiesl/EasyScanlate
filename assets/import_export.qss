#ImportDialog, #ExportDialog {
    background-color: var(--tredecenary);
    color: var(--text);
}
#ImportDialog QGroupBox, #ExportDialog QGroupBox {
    font-weight: bold;
    border: 2px solid var(--border_input);
    border-radius: var(--border_radius_small);
    margin-top: var(--spacing_large);
    padding-top: var(--spacing_large);
    background-color: var(--quaternary);
}
#ImportDialog QGroupBox::title, #ExportDialog QGroupBox::title {
    subcontrol-origin: margin;
    left: var(--spacing_large);
    padding: 0 var(--padding_medium);
}
#ImportDialog QLabel, #ExportDialog QLabel {
    color: var(--text);
}
#ImportDialog QPushButton, #ExportDialog QPushButton {
    background-color: var(--secondary);
    color: var(--text);
    border: 1px solid var(--border_input);
    border-radius: var(--border_radius_small);
    padding: var(--padding_6) var(--spacing_xlarge);
    min-width: 80px;
}
#ImportDialog QPushButton:hover, #ExportDialog QPushButton:hover {
    background-color: var(--duodenary);
}
#ImportDialog QPushButton:pressed, #ExportDialog QPushButton:pressed {
    background-color: var(--primary);
}
#ImportDialog QComboBox, #ExportDialog QComboBox {
    background-color: var(--primary);
    color: var(--text);
    border: 1px solid var(--border_input);
    border-radius: var(--border_radius_small);
    padding: var(--padding_small) var(--padding_large);
    min-width: 150px;
}
#ImportDialog QComboBox:hover, #ExportDialog QComboBox:hover {
    background-color: var(--secondary);
}
#ImportDialog QComboBox::drop-down, #ExportDialog QComboBox::drop-down {
    border: none;
}
#ImportDialog QComboBox QAbstractItemView, #ExportDialog QComboBox QAbstractItemView {
    background-color: var(--primary);
    color: var(--text);
    selection-background-color: var(--duodenary);
}
#ImportDialog QRadioButton, #ExportDialog QRadioButton {
    color: var(--text);
    spacing: var(--spacing_small);
}
#ImportDialog QRadioButton::indicator, #ExportDialog QRadioButton::indicator {
    width: var(--indicator_size_checkbox);
    height: var(--indicator_size_checkbox);
    border-radius: 8px;
    border: 2px solid var(--border_input);
    background-color: var(--tredecenary);
}
#ImportDialog QRadioButton::indicator:checked, #ExportDialog QRadioButton::indicator:checked {
    background-color: var(--accent_checked);
    border-color: var(--accent_checked);
}
#ImportDialog QCheckBox, #ExportDialog QCheckBox {
    color: var(--text);
    spacing: var(--spacing_small);
}
#ImportDialog QCheckBox::indicator, #ExportDialog QCheckBox::indicator {
    width: var(--indicator_size_checkbox);
    height: var(--indicator_size_checkbox);
    border: 2px solid var(--border_input);
    border-radius: 3px;
    background-color: var(--tredecenary);
}
#ImportDialog QCheckBox::indicator:checked, #ExportDialog QCheckBox::indicator:checked {
    background-color: var(--accent_checked);
    border-color: var(--accent_checked);
}
#ImportDialog QLineEdit, #ExportDialog QLineEdit {
    background-color: var(--primary);
    color: var(--text);
    border: 1px solid var(--border_input);
    border-radius: var(--border_radius_small);
    padding: var(--padding_small) var(--padding_large);
}
#ImportDialog QLineEdit:focus, #ExportDialog QLineEdit:focus {
    border-color: var(--accent_checked);
}
#ImportDialog QSpinBox, #ExportDialog QSpinBox {
    background-color: var(--primary);
    color: var(--text);
    border: 1px solid var(--border_input);
    border-radius: var(--border_radius_small);
    padding: var(--padding_small) var(--padding_large);
}