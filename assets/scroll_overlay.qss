/* ScrollButtonOverlay - Minimal floating overlay */
#ScrollButtonOverlay {
    background-color: transparent;
    border: none;
}

#ScrollButtonOverlay QPushButton:hover {
    background-color: rgba(69, 69, 69, 178);
}

#ScrollButtonOverlay QPushButton:pressed {
    background-color: rgba(37, 37, 37, 178);
}

/* Arrow buttons - Circular style */
#ScrollArrowButton {
    background-color: rgba(43, 43, 43, 178);
    border: none;
    border-radius: 20px;
    color: #FFFFFF;
}

/* Save button - Medium font, less padding */
#ScrollSaveButton {
    background-color: rgba(43, 43, 43, 178);
    border: none;
    border-radius: 4px;
    color: #FFFFFF;
    font-size: var(--font_size_medium);
    padding: 0px;
}
