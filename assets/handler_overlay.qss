/* Handler Overlay Base Styles */
#ManualOCROverlay,
#StitchWidget,
#SplitWidget,
#ContextFillOverlay {
    background-color: rgba(43, 43, 43, 178);
    border: 1px solid #606060;
    border-radius: 8px;
    padding: 0px;
}

/* Title Labels */
#ManualOCROverlay QLabel,
#StitchWidget QLabel,
#SplitWidget QLabel,
#ContextFillOverlay QLabel {
    color: #FFFFFF;
    font-size: var(--font_size_small);
    font-weight: bold;
    padding: 5px;
    qproperty-alignment: AlignCenter;
}

/* Info Labels (for SplitWidget info) */
#SplitWidget QLabel[info="true"] {
    font-weight: normal;
    color: #E0E0E0;
}

/* Button Layout */
#ManualOCROverlay QHBoxLayout,
#StitchWidget QHBoxLayout,
#SplitWidget QHBoxLayout,
#ContextFillOverlay QHBoxLayout {
    spacing: 8px;
    margin: 5px;
}

/* Primary Action Buttons */
#ManualOCROverlay QPushButton[objectName=""],
#StitchWidget QPushButton[objectName=""],
#SplitWidget QPushButton[objectName=""],
#ContextFillOverlay QPushButton[objectName=""] {
    background-color: #3A3A3A;
    border: 1px solid #606060;
    border-radius: 4px;
    color: #FFFFFF;
    padding: 6px 12px;
    font-size: var(--font_size_small);
    min-width: 80px;
}

#ManualOCROverlay QPushButton[objectName=""]:hover,
#StitchWidget QPushButton[objectName=""]:hover,
#SplitWidget QPushButton[objectName=""]:hover,
#ContextFillOverlay QPushButton[objectName=""]:hover {
    background-color: #454545;
    border-color: #707070;
}

#ManualOCROverlay QPushButton[objectName=""]:pressed,
#StitchWidget QPushButton[objectName=""]:pressed,
#SplitWidget QPushButton[objectName=""]:pressed,
#ContextFillOverlay QPushButton[objectName=""]:pressed {
    background-color: #252525;
}

#ManualOCROverlay QPushButton[objectName=""]:disabled,
#StitchWidget QPushButton[objectName=""]:disabled,
#SplitWidget QPushButton[objectName=""]:disabled,
#ContextFillOverlay QPushButton[objectName=""]:disabled {
    background-color: #2D2D2D;
    color: #777777;
    border-color: #404040;
}

/* Cancel Buttons */
#ManualOCROverlay QPushButton#CancelButton,
#StitchWidget QPushButton#CancelButton,
#SplitWidget QPushButton#CancelButton,
#ContextFillOverlay QPushButton#CancelButton {
    background-color: #5c3a3a;
    border: 1px solid #8a4a4a;
}

#ManualOCROverlay QPushButton#CancelButton:hover,
#StitchWidget QPushButton#CancelButton:hover,
#SplitWidget QPushButton#CancelButton:hover,
#ContextFillOverlay QPushButton#CancelButton:hover {
    background-color: #7a4a4a;
    border-color: #aa5a5a;
}

/* Reset Buttons */
#ManualOCROverlay QPushButton#ResetButton,
#StitchWidget QPushButton#ResetButton,
#SplitWidget QPushButton#ResetButton,
#ContextFillOverlay QPushButton#ResetButton {
    background-color: #4a4a5c;
    border: 1px solid #5a5a8a;
}

#ManualOCROverlay QPushButton#ResetButton:hover,
#StitchWidget QPushButton#ResetButton:hover,
#SplitWidget QPushButton#ResetButton:hover,
#ContextFillOverlay QPushButton#ResetButton:hover {
    background-color: #5a5a7a;
    border-color: #6a6aaa;
}
