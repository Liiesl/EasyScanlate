/* Global Tooltip Styling */
QToolTip {
    background-color: #2D2D2D;
    color: #E0E0E0;
    border: 1px solid #606060;
    border-radius: 4px;
    padding: 4px 8px;
}

/* Global Button Default */
QPushButton {
    background-color: rgba(43, 43, 43, 178);
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    color: #FFFFFF;
}

QPushButton:hover {
    background-color: rgba(69, 69, 69, 178);
}

QPushButton:pressed {
    background-color: rgba(37, 37, 37, 178);
}

QPushButton:disabled {
    background-color: rgba(68, 68, 68, 178);
    color: #777777;
}

/* Global QSplitter Styling */
QSplitter::handle {
    background-color: transparent;
}

QSplitter {
    background-color: transparent;
}
